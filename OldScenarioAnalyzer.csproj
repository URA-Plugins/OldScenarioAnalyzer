<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsUraPlugin>true</IsUraPlugin>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>

    <!-- URA 插件元数据：供发布 manifest 使用 -->
    <PluginInternalName>OldScenarioAnalyzer</PluginInternalName>
    <PluginDisplayName>解析旧剧本(种田杯以前)回合信息</PluginDisplayName>
    <PluginAuthor>离披</PluginAuthor>
    <PluginDescription>解析旧剧本(种田杯以前)回合信息</PluginDescription>
    <PluginRepositoryUrl>https://github.com/URA-Plugins/OldScenarioAnalyzer</PluginRepositoryUrl>
    <PluginDependencies>EventLoggerPlugin</PluginDependencies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventLoggerPlugin\EventLoggerPlugin.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
